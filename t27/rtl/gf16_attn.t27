module TrinityGf16AttnT27;
// Issue #115. gf16-attn-v1: generated layer-0 attention/residual controller.
//
// Board profile decision: every stage value is an exact Q16.16 s32 word, NOT
// a GF16 float. The FFN profile packs stages into GF16 words because its
// numeric contract is the GF16 float format; the attention oracle
// (tools/attn_reference.py) contracts Q16.16 stages, and in Q16.16 every
// product in the datapath stays inside one or two u64 limbs:
//   * ternary projections: |lane| < 2**16, 2560 lanes -> acc < 2**28 (1 limb),
//     then rne(acc * scale_q16, 16): < 2**44 (1 limb)
//   * scores: q.k products < 2**62, 128 lanes -> 2 limbs, then
//     rne(dot * scale_q16, 32): < 2**85 (2 limbs before the shift)
//   * RoPE: a*cos - b*sin < 2**47 (1 limb), rne(,16) -- identity at position 0
//   * context: sum of e*v terms < 2**50 (1 limb), one div_rne by the
//     exact integer denominator
//   * residual: one clamped u32 add
// The shared integer exponential exp_q16 (see tools/attn_reference.py) runs
// verbatim: 16-segment degree-6 even/odd-split Q32.32 polynomial, one RNE,
// every product below 2**64.
//
// Chain per position (causal, S positions): input_layernorm -> q/k/v ternary
// projections (20 heads x 128, GQA 4:1 over 5 kv heads) -> RoPE (theta 500000,
// rotate_half from a Q16.16 cos/sin table) -> scaled QK^T scores -> softmax
// (exp_q16 over the exact delta from the row maximum) -> context ->
// attn_sub_norm -> o_proj -> residual add.
//
// This slice implements one position (doorbell positions == 1): RoPE is the
// identity there, the softmax has one entry (e = 65536, denominator 65536,
// context = v through the real div_rne path), and qr/kr equal q/k.
//
// Every state body obeys the single-pass rule: a value assigned in the body
// is never read again inside the same body (t27 assigns are non-blocking).
// Memory map (128-bit words, 16 bytes each):
//   64       doorbell: run_id | 0x41545431<<32; read1 = positions | (result<<32)
//   80..83   scales q,k,v,o (Q16.16); 84 = attention scaling head_dim**-0.5
//   4096+    x, H Q16.16 words
//   8192+    input_layernorm weights, H words
//   10752+   attn_sub_norm weights, H words
//   65536+   q_proj trits, H rows x 40 words (64 lanes of 2 bits)
//   167936+  k_proj trits, KV x 40
//   193536+  v_proj trits, KV x 40
//   219136+  o_proj trits, H x 40
//   321536+  RoPE cos/sin tables (next slice)
// Report tags: 71 header, 100 run, 99 cycles, 118 counters, 122 done,
// 69 error; stages n=103,q=104,k=105,v=106,qr=107,kr=108,sc=109,a=110,
// c=111,o=112,r=113.
fn pick(flag: bool, a: u64, b: u64) -> u64 { if (flag) { return a; } return b; }
fn carry(a: u64, b: u64) -> u64 { if (a+b < a) { return 1; } return 0; }
fn rne_shift(num: u64, shift: u32) -> u64 {
    let q: u64 = num >> shift;
    let rem: u64 = num & (((1 as u64) << shift)-1);
    let half: u64 = (1 as u64) << (shift-1);
    if (rem > half) { return q+1; }
    if (rem == half) { if ((q & 1) != 0) { return q+1; } }
    return q;
}
fn exp_q16(delta: u32) -> u32 {
    let z: u64 = ((0 as u64)-(delta as u64)) & 4294967295;
    if (z >= 772244) { return 0; }
    let u: u64 = z*6196328019;
    let m: u32 = (u >> 48) as u32;
    let f: u64 = u & 281474976710655;
    let j: u32 = (f >> 44) as u32;
    let g: u64 = (f & 17592186044415) >> 16;
    let h: u64 = (g*g) >> 32;
    var t: [16]u64 = [4294967296,4069266217,3855590487,3652782173,3459768862,3275563729,3099261112,2941586669,2792457426,2651431154,2517923900,2391323354,2271242040,2157314223,2049211269,1946633450];
    var a2: u64 = ((661577*h) >> 32)+41309550;
    var a1: u64 = ((a2*h) >> 32)+1031764991;
    var a0: u64 = ((a1*h) >> 32)+4294967296;
    var b1: u64 = ((5726720*h) >> 32)+238388332;
    var b0: u64 = ((b1*h) >> 32)+2977044472;
    var p: u64 = a0-((g*b0) >> 32);
    let y: u64 = pick(j == 0,p,(t[j]*p) >> 32);
    return rne_shift(y, 16+m) as u32;
}
fn sign64(word: u32) -> bool { return (word >> 31) != 0; }
fn extend(word: u32) -> u64 {
    // Q16.16 u32 pattern, sign-extended into u64 two's complement.
    if ((word >> 31) != 0) { return ((word as u64) | 18446744069414584320); }
    return word as u64;
}
fn mag64(word: u32) -> u64 {
    // u64 subtraction masked to 32 bits: 2**32 - pattern = |value|.
    // (A bare u32 negation widens to the return width in the Verilog backend
    // and disagrees with the C backend, so the wrap is explicit here.)
    if ((word >> 31) != 0) { return ((0 as u64)-(word as u64)) & 4294967295; }
    return word as u64;
}

var state: u32 = 0;
var index: u32 = 0;
var row: u32 = 0;
var col: u32 = 0;
var bitpos: u32 = 0;
var head: u32 = 0;
var length: u32 = 0;
var nrows: u32 = 0;
var group: u32 = 0;
var weight_addr: u32 = 0;
var last_run: u32 = 0;
var run_id: u32 = 0;
var poll: u32 = 0;
var active: bool = false;
var cycles: u64 = 0;
var report_cycles: u64 = 0;
var memory_cycles: u64 = 0;
var result_only: bool = false;
var positions: u32 = 0;
var error_code: u32 = 0;
var vec: [8192]u32;
var gate: [8192]u32;
var up: [8192]u32;
var scale_q: u32 = 0;
var scale_k: u32 = 0;
var scale_v: u32 = 0;
var scale_o: u32 = 0;
var scale_attn: u32 = 0;
var lane: u64 = 0;
var acc0: u64 = 0;
var acc1: u64 = 0;
var term0: u64 = 0;
var term1: u64 = 0;
var add0: u64 = 0;
var add1: u64 = 0;
var add_carry: u64 = 0;
var weight0: u64 = 0;
var weight1: u64 = 0;
var wb_cyc: bool = false;
var wb_stb: bool = false;
var wb_addr: u32 = 0;
var response: u32 = 0;
var read0: u64 = 0;
var read1: u64 = 0;
var quiet: u32 = 0;
var pending: bool = false;
var ptag: u32 = 0;
var pa: u32 = 0;
var pb: u64 = 0;
var emit_tag: u32 = 0;
var emit_value: u32 = 0;
var emit_index: u32 = 0;
var after_emit: u32 = 0;
var arb: u32 = 0;
var sbuf: bool = false;
var sb_tag: u32 = 0;
var sb_a: u32 = 0;
var sb_b: u64 = 0;
var line_go: bool = false;
var line_tag: u32 = 0;
var line_a: u32 = 0;
var line_b: u64 = 0;
var s_idle: bool;
// Norm internals: sumsq 2-limb Q32.32, mean division, isqrt root, per-lane
// div_rne with the mag/sign trick (verified identical to the oracle divmod).
var sumsq0: u64 = 0;
var sumsq1: u64 = 0;
var rem0: u64 = 0;
var rem1: u64 = 0;
var quo0: u64 = 0;
var quo1: u64 = 0;
var divisor: u64 = 0;
var root: u64 = 0;
var rms: u64 = 0;
var sub0: u64 = 0;
var sub1: u64 = 0;
var cmp0: u64 = 0;
var cmp1: u64 = 0;
var num_mag: u64 = 0;
var num_sign: bool = false;
var out_mag: u64 = 0;
var quant: u64 = 0;
var twice: u64 = 0;
var inc: u64 = 0;
var exp_delta: u32 = 0;
var exp_value: u32 = 0;
var exp_denom: u32 = 0;
var norm_pass: u32 = 0;
var projection_stage: u32 = 0;
var store_base: u32 = 0;
var proj_scale: u32 = 0;
var proj_tag: u32 = 0;
var sample_q: u32 = 0;
var weight_q: u32 = 0;
s_idle = !sbuf;

fn on_clock(calib: bool, stall: bool, ack: bool, rdata_lo: u64, rdata_hi: u64,
            hidden: u32, kv: u32, heads: u32, kv_heads: u32, head_dim: u32,
            line_idle: bool, s_go: bool, s_tag: u32, s_a: u32, s_b: u64) {
    if (active) {
        cycles = cycles+1;
        if (state == 8 || state == 300 || state == 301) { report_cycles = report_cycles+1; }
        if (state == 200 || state == 201) { memory_cycles = memory_cycles+1; }
    }
    group = heads / kv_heads;
    if (state == 0) {
        if (calib) { wb_cyc = true; ptag = 71; pa = hidden; pb = kv as u64; pending = true; state = 1; }
    } else if (state == 1) {
        if (poll == 0 && !pending) { wb_addr = 64; wb_stb = true; response = 2; state = 200; quiet = 0; }
        else if (poll != 0) { poll = poll-1; }
    } else if (state == 2) {
        state = 1; poll = 8192;
        if ((read0 >> 32) == 0x41545431 && (read0 as u32) != 0 && (read0 as u32) != last_run) {
            last_run = read0 as u32; run_id = read0 as u32; index = 0; active = true;
            cycles = 0; report_cycles = 0; memory_cycles = 0; error_code = 0; state = 8;
            positions = read1 as u32; result_only = (read1 >> 32) != 0;
            if ((read1 as u32) == 0 || (read1 as u32) > 8) { error_code = 10; state = 900; }
            if ((read1 as u32) != 1) { error_code = 11; state = 900; }
            if ((read1 >> 32) != 0) { error_code = 12; state = 900; }
        }
    } else if (state == 8) {
        if (!pending) { ptag = 100; pa = run_id; pb = positions as u64; pending = true; state = 3; }
    } else if (state == 3) {
        wb_addr = 80+index; wb_stb = true; response = 4; state = 200; quiet = 0;
    } else if (state == 4) {
        if (index == 0) { scale_q = read0 as u32; }
        if (index == 1) { scale_k = read0 as u32; }
        if (index == 2) { scale_v = read0 as u32; }
        if (index == 3) { scale_o = read0 as u32; }
        if (index == 4) { scale_attn = read0 as u32; index = 0; state = 10; }
        else { index = index+1; state = 3; }
    } else if (state == 10) {
        index = 0; state = 11;
    } else if (state == 11) {
        wb_addr = 4096+index; wb_stb = true; response = 12; state = 200; quiet = 0;
    } else if (state == 12) {
        vec[index & 8191] = read0 as u32;
        if (index+1 == hidden) { index = 0; state = 13; }
        else { index = index+1; state = 11; }
    } else if (state == 13) {
        wb_addr = 8192+index; wb_stb = true; response = 14; state = 200; quiet = 0;
    } else if (state == 14) {
        up[index & 8191] = read0 as u32;
        if (index+1 == hidden) { index = 0; norm_pass = 0; state = 20; }
        else { index = index+1; state = 13; }
    } else if (state == 20) {
        // Norm pass: sumsq = sum of squares (Q32.32, 2 limbs).
        index = 0; sumsq0 = 0; sumsq1 = 0; state = 21;
    } else if (state == 21) {
        sample_q = pick(norm_pass == 0, vec[index & 8191], up[index & 8191]);
        state = 22;
    } else if (state == 22) {
        lane = mag64(sample_q);
        state = 23;
    } else if (state == 23) {
        add0 = sumsq0+lane*lane; add_carry = carry(sumsq0,lane*lane);
        state = 24;
    } else if (state == 24) {
        sumsq0 = add0; sumsq1 = sumsq1+add_carry;
        if (index+1 == hidden) { state = 25; }
        else { index = index+1; state = 21; }
    } else if (state == 25) {
        // mean = div_rne(sumsq, hidden): restoring 74-bit / u32 division.
        rem0 = 0; rem1 = 0; quo0 = 0; quo1 = 0; divisor = hidden as u64; bitpos = 73; state = 26;
    } else if (state == 26) {
        if (bitpos >= 64) { rem0 = (rem0 << 1) | pick((sumsq1 >> (bitpos-64)) & 1 != 0,1,0); }
        else { rem0 = (rem0 << 1) | pick((sumsq0 >> bitpos) & 1 != 0,1,0); }
        rem1 = (rem1 << 1) | (rem0 >> 63);
        state = 27;
    } else if (state == 27) {
        if (rem1 != 0 || rem0 >= divisor) {
            if (rem0 < divisor) { rem1 = rem1-1; }
            rem0 = rem0-divisor;
            if (bitpos >= 64) { quo1 = quo1 | ((1 as u64) << (bitpos-64)); }
            else { quo0 = quo0 | ((1 as u64) << bitpos); }
        }
        if (bitpos == 0) { state = 28; }
        else { bitpos = bitpos-1; state = 26; }
    } else if (state == 28) {
        // RNE of the division: rem < divisor so rem1 is 0.
        add0 = quo0+pick((rem0 << 1) > divisor || ((rem0 << 1) == divisor && (quo0 & 1) != 0),1,0);
        add_carry = carry(quo0,pick((rem0 << 1) > divisor || ((rem0 << 1) == divisor && (quo0 & 1) != 0),1,0));
        state = 30;
    } else if (state == 30) {
        quo0 = add0; quo1 = quo1+add_carry; state = 31;
    } else if (state == 31) {
        // rms = isqrt((mean + EPS_Q32) << 32), Q32.32: build the 2-limb value.
        rem1 = ((quo1+carry(quo0,42950)) << 32) | ((quo0+42950) >> 32);
        rem0 = (quo0+42950) << 32;
        root = 0; bitpos = 94; state = 32;
    } else if (state == 32) {
        // Restoring isqrt: the subtrahend is (4*root+1) << bitpos, two limbs
        // (the low limb wraps in u64, which is the exact low half).
        if (bitpos >= 64) { cmp1 = ((root << 2) | 1) << (bitpos-64); cmp0 = 0; }
        else { cmp1 = ((root << 2) | 1) >> (64-bitpos); cmp0 = ((root << 2) | 1) << bitpos; }
        state = 33;
    } else if (state == 33) {
        if (rem1 > cmp1 || (rem1 == cmp1 && rem0 >= cmp0)) {
            rem1 = rem1-cmp1-pick(rem0 < cmp0,1,0); rem0 = rem0-cmp0;
            root = (root << 1) | 1;
        } else { root = root << 1; }
        if (bitpos == 0) { state = 34; }
        else { bitpos = bitpos-2; state = 32; }
    } else if (state == 34) {
        rms = root; index = 0; state = 40;
    } else if (state == 40) {
        // Per lane: q = div_rne(mag(t)*mag(w) << 16, rms), sign of t xor w.
        sample_q = pick(norm_pass == 0, vec[index & 8191], up[index & 8191]);
        weight_q = pick(norm_pass == 0, up[index & 8191], gate[index & 8191]);
        state = 41;
    } else if (state == 41) {
        num_sign = sign64(sample_q) != sign64(weight_q);
        num_mag = (mag64(sample_q)*mag64(weight_q)) << 16;
        rem0 = 0; quo0 = 0; bitpos = 63; state = 42;
    } else if (state == 42) {
        rem0 = (rem0 << 1) | pick((num_mag >> bitpos) & 1 != 0,1,0);
        state = 43;
    } else if (state == 43) {
        if (rem0 >= rms) { rem0 = rem0-rms; quo0 = quo0 | ((1 as u64) << bitpos); }
        if (bitpos == 0) { state = 44; }
        else { bitpos = bitpos-1; state = 42; }
    } else if (state == 44) {
        out_mag = quo0+pick((rem0 << 1) > rms || ((rem0 << 1) == rms && (quo0 & 1) != 0),1,0);
        state = 45;
    } else if (state == 45) {
        if (num_sign) {
            if (out_mag > 2147483648) { quant = 2147483648; }
            else { quant = (0 as u64)-out_mag; }
        } else {
            if (out_mag > 2147483647) { quant = 2147483647; }
            else { quant = out_mag; }
        }
        state = 47;
    } else if (state == 47) {
        gate[index & 8191] = quant as u32;
        emit_tag = pick(norm_pass == 0,103,111); emit_index = index; emit_value = quant as u32; after_emit = 46; state = 300;
    } else if (state == 46) {
        if (index+1 == hidden) {
            if (norm_pass == 0) { state = 50; }
            else { state = 111; }
        }
        else { index = index+1; state = 40; }
    } else if (state == 50) {
        // q projection: H rows x H cols, exact signed accumulation.
        projection_stage = 0; store_base = hidden; proj_scale = scale_q; proj_tag = 104;
        row = 0; col = 0; acc0 = 0; nrows = hidden; weight_addr = 65536; state = 71;
    } else if (state == 60) {
        projection_stage = 1; store_base = 0; proj_scale = scale_k; proj_tag = 105;
        row = 0; col = 0; acc0 = 0; nrows = kv; weight_addr = 167936; state = 71;
    } else if (state == 70) {
        projection_stage = 2; store_base = hidden; proj_scale = scale_v; proj_tag = 106;
        row = 0; col = 0; acc0 = 0; nrows = kv; weight_addr = 193536; state = 71;
    } else if (state == 71) {
        wb_addr = weight_addr; wb_stb = true; response = 72; state = 200; quiet = 0;
    } else if (state == 72) {
        weight0 = read0; weight1 = read1; state = 73;
    } else if (state == 73) { state = 74;
    } else if (state == 74) {
        term0 = pick((weight0 & 3) == 0,0,pick((weight0 & 3) == 2,(0 as u64)-extend(gate[col & 8191]),extend(gate[col & 8191])));
        state = 75;
        weight0 = (weight0 >> 2) | (weight1 << 62); weight1 = weight1 >> 2; col = col+1;
        if ((weight0 & 3) == 3) { error_code = 3; state = 900; }
    } else if (state == 75) {
        add0 = acc0+term0; add_carry = carry(acc0,term0); state = 76;
    } else if (state == 76) {
        acc0 = add0;
        if (col == hidden) { weight_addr = weight_addr+1; state = 77; }
        else if ((col & 63) == 0) { weight_addr = weight_addr+1; state = 71; }
        else { state = 74; }
    } else if (state == 77) {
        // out = clamp_s32(rne(acc * scale, 16)): |acc| < 2**43, 1 limb.
        quant = rne_shift(pick((acc0 >> 63) != 0,(0 as u64)-acc0,acc0)*proj_scale as u64,16);
        state = 78;
    } else if (state == 78) {
        if ((acc0 >> 63) != 0) {
            if (quant > 2147483648) { quant = 2147483648; }
            else { quant = (0 as u64)-quant; }
        } else if (quant > 2147483647) { quant = 2147483647; }
        state = 79;
    } else if (state == 79) {
        if (projection_stage == 0) { gate[(store_base+row) & 8191] = quant as u32; }
        if (projection_stage == 1) { up[(store_base+row) & 8191] = quant as u32; }
        if (projection_stage == 2) { vec[(store_base+row) & 8191] = quant as u32; }
        if (projection_stage == 3) { gate[(store_base+row) & 8191] = quant as u32; }
        emit_tag = proj_tag; emit_index = row; emit_value = quant as u32; after_emit = 800; state = 300;
    } else if (state == 800) {
        acc0 = 0; col = 0;
        if (row+1 == nrows) {
            if (projection_stage == 0) { state = 60; }
            else if (projection_stage == 1) { state = 70; }
            else if (projection_stage == 2) { index = 0; state = 80; }
            else { index = 0; state = 120; }
        } else { row = row+1; state = 71; }
    } else if (state == 80) {
        // qr = q (RoPE identity at position 0).
        emit_tag = 107; emit_index = index; emit_value = gate[(hidden+index) & 8191]; after_emit = 81; state = 300;
    } else if (state == 81) {
        if (index+1 == hidden) { index = 0; state = 82; }
        else { index = index+1; state = 80; }
    } else if (state == 82) {
        emit_tag = 108; emit_index = index; emit_value = up[index & 8191]; after_emit = 83; state = 300;
    } else if (state == 83) {
        if (index+1 == kv) { head = 0; state = 85; }
        else { index = index+1; state = 82; }
    } else if (state == 85) {
        // Score of head h: 2-limb dot over head_dim lanes, then rne(dot*scale,32).
        col = 0; acc0 = 0; acc1 = 0; state = 86;
    } else if (state == 86) {
        lane = extend(gate[(hidden+head*head_dim+col) & 8191])*extend(up[((head / group) * head_dim + col) & 8191]);
        state = 87;
    } else if (state == 87) {
        add0 = acc0+lane;
        add1 = acc1+pick((lane >> 63) != 0,18446744073709551615,0)+carry(acc0,lane);
        state = 88;
    } else if (state == 88) {
        acc0 = add0; acc1 = add1;
        if (col+1 == head_dim) { state = 89; }
        else { col = col+1; state = 86; }
    } else if (state == 89) {
        // dot magnitude: out_mag = |low limb|, rem1 = |high limb| (2-limb).
        if ((acc1 >> 63) != 0) { out_mag = (0 as u64)-acc0; rem1 = (0 as u64)-acc1-pick(acc0 != 0,1,0); }
        else { out_mag = acc0; rem1 = acc1; }
        state = 90;
    } else if (state == 90) {
        // product = scale * (rem1*2**64 + out_mag); result >> 32 in one pass.
        rem0 = ((scale_attn as u64)*(out_mag & 4294967295)) & 4294967295;
        add0 = ((scale_attn as u64)*(out_mag >> 32)+((scale_attn as u64)*(out_mag & 4294967295) >> 32)) & 4294967295;
        add1 = (scale_attn as u64)*rem1+(((scale_attn as u64)*(out_mag >> 32)+((scale_attn as u64)*(out_mag & 4294967295) >> 32)) >> 32);
        state = 91;
    } else if (state == 91) {
        quant = ((add1 << 32) | add0)+pick(rem0 > 2147483648 || (rem0 == 2147483648 && ((((add1 << 32) | add0) & 1) != 0)),1,0);
        state = 92;
    } else if (state == 92) {
        if ((acc1 >> 63) != 0) {
            if (quant > 2147483648) { quant = 2147483648; }
            else { quant = (0 as u64)-quant; }
        } else if (quant > 2147483647) { quant = 2147483647; }
        state = 93;
    } else if (state == 93) {
        sample_q = quant as u32;
        exp_value = exp_q16(0);
        state = 95;
    } else if (state == 95) {
        exp_denom = exp_value;
        emit_tag = 109; emit_index = head; emit_value = sample_q; after_emit = 94; state = 300;
    } else if (state == 94) {
        if (head+1 == heads) { index = 0; state = 100; }
        else { head = head+1; state = 85; }
    } else if (state == 100) {
        // Context lane index h*HD+d reads v lane (h/group)*HD+d (GQA).
        sample_q = vec[(hidden+((index / head_dim) / group) * head_dim + (index & (head_dim-1))) & 8191];
        state = 101;
    } else if (state == 101) {
        num_mag = mag64(sample_q)*exp_value as u64;
        num_sign = sign64(sample_q);
        rem0 = 0; quo0 = 0; bitpos = 63; state = 102;
    } else if (state == 102) {
        rem0 = (rem0 << 1) | pick((num_mag >> bitpos) & 1 != 0,1,0);
        state = 103;
    } else if (state == 103) {
        if (rem0 >= exp_denom as u64) { rem0 = rem0-(exp_denom as u64); quo0 = quo0 | ((1 as u64) << bitpos); }
        if (bitpos == 0) { state = 104; }
        else { bitpos = bitpos-1; state = 102; }
    } else if (state == 104) {
        out_mag = quo0+pick((rem0 << 1) > exp_denom as u64 || ((rem0 << 1) == exp_denom as u64 && (quo0 & 1) != 0),1,0);
        state = 105;
    } else if (state == 105) {
        if (num_sign) {
            if (out_mag > 2147483648) { quant = 2147483648; }
            else { quant = (0 as u64)-out_mag; }
        } else {
            if (out_mag > 2147483647) { quant = 2147483647; }
            else { quant = out_mag; }
        }
        state = 106;
    } else if (state == 106) {
        up[index & 8191] = quant as u32;
        emit_tag = 110; emit_index = index; emit_value = quant as u32; after_emit = 107; state = 300;
    } else if (state == 107) {
        if (index+1 == hidden) { state = 108; }
        else { index = index+1; state = 100; }
    } else if (state == 108) {
        // Load attn_sub_norm weights into gate (n is dead), then the sub-norm pass.
        index = 0; state = 109;
    } else if (state == 109) {
        wb_addr = 10752+index; wb_stb = true; response = 110; state = 200; quiet = 0;
    } else if (state == 110) {
        gate[index & 8191] = read0 as u32;
        if (index+1 == hidden) { index = 0; norm_pass = 1; state = 20; }
        else { index = index+1; state = 109; }
    } else if (state == 111) {
        // o projection: H rows x H cols from c (gate[0..H-1]) into gate[H..2H-1].
        projection_stage = 3; store_base = hidden; proj_scale = scale_o; proj_tag = 112;
        row = 0; col = 0; acc0 = 0; nrows = hidden; weight_addr = 219136; state = 71;
    } else if (state == 120) {
        // residual: r = clamp_s32(x + o).
        lane = extend(vec[index & 8191])+extend(gate[(hidden+index) & 8191]);
        state = 121;
    } else if (state == 121) {
        if ((lane >> 63) != 0) {
            if (lane < 18446744071562067968) { quant = 2147483648; }
            else { quant = lane; }
        } else if (lane > 2147483647) { quant = 2147483647; }
        else { quant = lane; }
        state = 123;
    } else if (state == 123) {
        emit_tag = 113; emit_index = index; emit_value = quant as u32; after_emit = 122; state = 300;
    } else if (state == 122) {
        if (index+1 == hidden) { active = false; state = 600; }
        else { index = index+1; state = 120; }
    } else if (state == 200) {
        quiet = quiet+1;
        if (!stall) { wb_stb = false; state = 201; }
        if (ack) { read0 = rdata_lo; read1 = rdata_hi; wb_stb = false; state = response; }
        if (quiet >= 16777216) { error_code = 4; wb_stb = false; state = 900; }
    } else if (state == 201) {
        quiet = quiet+1;
        if (ack) { read0 = rdata_lo; read1 = rdata_hi; state = response; }
        if (quiet >= 16777216) { error_code = 4; state = 900; }
    } else if (state == 300) {
        if (!pending) { ptag = emit_tag; pa = emit_index; pb = emit_value as u64; pending = true; state = 301; }
    } else if (state == 301) {
        if (!pending) { state = after_emit; }
    } else if (state == 600) {
        if (!pending) { ptag = 99; pa = run_id; pb = cycles; pending = true; state = 601; }
    } else if (state == 601) {
        if (!pending) { ptag = 118; pa = 0; pb = report_cycles; pending = true; state = 602; }
    } else if (state == 602) {
        if (!pending) { ptag = 118; pa = 1; pb = memory_cycles; pending = true; state = 603; }
    } else if (state == 603) {
        if (!pending) { ptag = 122; pa = run_id; pb = 0; pending = true; state = 1; poll = 8192; }
    } else if (state == 900) {
        active = false; wb_cyc = false; wb_stb = false;
        if (!pending) { ptag = 69; pa = error_code; pb = run_id as u64; pending = true; state = 901; }
    }
    if (active && !calib) { error_code = 2; state = 900; }
    if (ack && state != 200 && state != 201) { error_code = 5; state = 900; }
    line_go = false;
    if (s_go) { sbuf = true; sb_tag = s_tag; sb_a = s_a; sb_b = s_b; }
    if (arb == 0) {
        if (line_idle && sbuf) { line_go = true; line_tag = sb_tag; line_a = sb_a; line_b = sb_b; sbuf = false; arb = 1; }
        else if (line_idle && pending) { line_go = true; line_tag = ptag; line_a = pa; line_b = pb; pending = false; arb = 1; }
    } else if (arb == 1) { arb = 2; }
    else if (line_idle) { arb = 0; }
}

test exp_zero { assert_eq(exp_q16(0),65536); }
test exp_deep { assert_eq(exp_q16(4294967295),0); }
test exp_one { assert_eq(exp_q16(4294901760),65535); }
