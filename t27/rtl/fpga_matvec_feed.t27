module TrinityFpgaMatvecFeedT27;

// The words of a device matvec run from DDR3 (issue #64): Wishbone master 1 of the DDR3 matvec
// build (fpga/ax7203/ddr3/tms_ddr3_loader_ax7203.v with `define DDR3_MATVEC), on the arbiter
// t27/rtl/fpga_wb_arbiter.t27, feeding t27/rtl/fpga_ddr3_matvec.t27. x16 only: one Wishbone
// word is 128 bits, 16 bytes, byte n at bits [8n, 8n+7] (bytes 0-7 in rdata_lo, 8-15 in
// rdata_hi), the word the matvec takes.
//
// The loader's M handler (t27/rtl/fpga_ddr3_loader.t27) starts it (`start`, one clock) with the
// region's first burst (the M frame's address / 16) and the run's words (rows x words per row,
// at least 1), in the clock it starts the matvec. The feed waits for the matvec's in_ready (the
// run has left SETUP and MASK), then asks for the words in address order, one request per word
// (a request is taken on a clock with stb and not stall; a presented request is never withdrawn
// or changed), at most `cap` outstanding, and hands every acknowledged word to the matvec in
// the clock of its ack (in_valid, in_lo, in_hi: module-level, straight from the ack). UberDDR3
// acknowledges in order, so ack k carries word k. The matvec takes a word in every clock of RUN
// while words are expected (docs/bridge.md, "Device matvec"), and in_ready rose before the first
// request: every ack is taken in its clock, so there is no FIFO, and the feed asks for exactly
// the run's words, so in_ready stays high until the last one. cyc is high from the first
// request to the last ack: the arbiter keeps the port with the feed for the whole run.
//
// Watchdog: `watchdog` clocks without in_ready (WAIT), or with neither a request taken nor an
// ack (READ), end the feed's part of the run: it pulses `abort` for one clock (the matvec ends
// the run at once, status 2, only its Z lines, rather than after its own idle limit) and asks for
// nothing more. A request presented at that moment stays presented, unchanged, until it is taken
// (the Wishbone rule the arbiter and the controller rely on: a stalled request is never
// withdrawn). Acks of the requests taken then come as the arbiter delivers them; DRAIN counts
// them (`dropped`, not handed to the matvec) and the feed keeps cyc and stays busy until the
// last one, so a later run never takes a word of this one. Acks while idle, and in DRAIN with
// nothing outstanding, count as `stray` (must be 0).
// `busy` is high from `start` until the feed is idle again; the M handler refuses X and M
// frames while it or the matvec is busy.
// Every statement of on_clock reads a variable before the same tick writes it.
const F_IDLE: u32 = 0;
const F_WAIT: u32 = 1;
const F_READ: u32 = 2;
const F_DRAIN: u32 = 3;

var st: u32 = 0;
var busy: bool = false;
var abort: bool = false;
var wb_cyc: bool = false;
var wb_stb: bool = false;
var wb_addr: u32 = 0;
var last_addr: u32 = 0;
var issue_done: bool = false;
var outst: u32 = 0;
var quiet: u32 = 0;
// Counters (whole time since reset).
var runs: u32 = 0;
var words: u32 = 0;
var timeouts: u32 = 0;
var dropped: u32 = 0;
var stray: u32 = 0;
var max_outst: u32 = 0;
var cmd_stalls: u32 = 0;

fn pick32(sel: bool, x: u32, y: u32) -> u32 {
    if (sel) { return x; }
    return y;
}

fn pick_bool(sel: bool, x: bool, y: bool) -> bool {
    if (sel) { return x; }
    return y;
}

// Module-level (combinational) values. The outstanding count after this clock and whether it
// leaves room under the cap are selected by the request taken and the ack from values computed
// off the registered count, as in fpga_ddr3_reader.t27, so no adder sits between o_wb_stall
// and the next stb.
var accept: bool;
var progress: bool;
var final_ack: bool;
var timeout: bool;
var out_up: u32;
var out_down: u32;
var out_next: u32;
var can_issue: bool;
var in_valid: bool;
var in_lo: u64;
var in_hi: u64;
var ack_owed: bool;
var out_drain: u32;
accept = wb_stb && !stall;
progress = accept || ack;
final_ack = st == F_READ && ack && issue_done && outst == 1 && !accept;
timeout = !progress && quiet >= watchdog;
// At most `cap` (64 in the build) outstanding: seven bits, so the adders are seven bits wide.
out_up = (outst + 1) & 127;
out_down = (outst - 1) & 127;
out_next = pick32(accept && !ack, out_up, pick32(ack && !accept, out_down, outst));
can_issue = pick_bool(accept && !ack, out_up < cap, pick_bool(ack && !accept, out_down < cap, outst < cap));
in_valid = st == F_READ && ack;
// DRAIN counts only the acks it is owed: an ack with nothing outstanding (stray: the arbiter's
// status line arb_stray counts it too) must not make the count wrap and the feed wait for ever.
ack_owed = ack && outst != 0;
out_drain = pick32(accept && !ack_owed, out_up, pick32(ack_owed && !accept, out_down, outst));
in_lo = rdata_lo;
in_hi = rdata_hi;

// start: begin a run (one clock, only while idle); s_base: first burst; s_words: words (>= 1);
// mv_ready: the matvec's in_ready; stall, ack, rdata_lo, rdata_hi: master 1's side of the
// arbiter; cap: requests outstanding at most (>= 1); watchdog: clocks (>= 1).
fn on_clock(start: bool, s_base: u32, s_words: u32, mv_ready: bool, stall: bool, ack: bool,
            rdata_lo: u64, rdata_hi: u64, cap: u32, watchdog: u32) {
    abort = false;
    if (st == F_IDLE) {
        if (ack) { stray = stray + 1; }
        if (start) {
            wb_addr = s_base;
            last_addr = s_base + s_words - 1;
            quiet = 0;
            busy = true;
            st = F_WAIT;
        }
    } else if (st == F_WAIT) {
        if (ack) { stray = stray + 1; }
        if (mv_ready) {
            wb_cyc = true;
            wb_stb = true;
            issue_done = false;
            outst = 0;
            quiet = 0;
            st = F_READ;
        } else if (quiet >= watchdog) {
            abort = true;
            timeouts = timeouts + 1;
            busy = false;
            st = F_IDLE;
        } else {
            quiet = quiet + 1;
        }
    } else if (st == F_READ) {
        if (wb_stb && stall) { cmd_stalls = cmd_stalls + 1; }
        if (outst > max_outst) { max_outst = outst; }
        if (accept) {
            if (wb_addr == last_addr) {
                wb_stb = false;
                issue_done = true;
            } else {
                wb_addr = wb_addr + 1;
                wb_stb = can_issue;
            }
        } else if (!wb_stb && !issue_done) {
            wb_stb = can_issue;
        }
        outst = out_next;
        if (ack) { words = words + 1; }
        if (progress) { quiet = 0; } else { quiet = quiet + 1; }
        if (final_ack) {
            wb_cyc = false;
            runs = runs + 1;
            busy = false;
            st = F_IDLE;
        } else if (timeout) {
            // No request taken and no ack in this clock: out_next is the count that stays, and a
            // presented request stays presented (wb_stb unchanged) until DRAIN sees it taken.
            abort = true;
            timeouts = timeouts + 1;
            if (out_next == 0 && !wb_stb) {
                wb_cyc = false;
                busy = false;
                st = F_IDLE;
            } else {
                st = F_DRAIN;
            }
        }
    } else {
        // DRAIN: the request still presented when the watchdog gave up is taken, then the acks of
        // every request taken are dropped; idle again when nothing is presented or outstanding.
        if (accept) { wb_stb = false; }
        if (ack_owed) { dropped = dropped + 1; }
        if (ack && !ack_owed) { stray = stray + 1; }
        outst = out_drain;
        if ((!wb_stb || accept) && out_drain == 0) {
            wb_cyc = false;
            busy = false;
            st = F_IDLE;
        }
    }
}

test cap_room { assert_eq(pick_bool(true, 3 < 4, false), true); assert_eq(pick32(false, 1, 7), 7); }
endmodule
