fn crc_byte(c: u32, b: u32) -> u32 {
    var x: u32 = c ^ (b & 255);
    var i: u32 = 0;
    while (i < 8) {
        if ((x & 1) != 0) { x = (x >> 1) ^ CRC_POLY; } else { x = x >> 1; }
        i = i + 1;
    }
    return x;
}

// Check byte of a line: low byte of the CRC-32 of tag, a (4 bytes) and v (4 bytes), as the loader.
fn line_check(tag: u32, a: u32, v: u32) -> u32 {
    var c: u32 = crc_byte(ALL_ONES, tag);
    c = crc_byte(c, a);
    c = crc_byte(c, a >> 8);
    c = crc_byte(c, a >> 16);
    c = crc_byte(c, a >> 24);
    c = crc_byte(c, v);
    c = crc_byte(c, v >> 8);
    c = crc_byte(c, v >> 16);
    c = crc_byte(c, v >> 24);
    return (c ^ ALL_ONES) & 255;
}

fn line_bits(tag: u32, a: u32, v: u32) -> u64 {
    var hi: u64 = line_check(tag, a, v) as u64;
    return (hi << 32) | (v as u64);
}

// Dense5 byte -> its five lane codes in bits 9:0, bit 10 set for an invalid code (243-255,
// lanes 00). The tables of fpga_ddr3_reader.t27: output bit k of code c is bit c mod 32 of
// word c / 32 of table k.
fn d5t0(w: u64) -> u64 {
    var t: u64 = 613566756;
    if (w == 1) { t = 1227133513; }
    if (w == 2) { t = 2454267026; }
    if (w == 3) { t = 613566756; }
    if (w == 4) { t = 1227133513; }
    if (w == 5) { t = 2454267026; }
    if (w == 6) { t = 613566756; }
    if (w == 7) { t = 299593; }
    return t;
}

