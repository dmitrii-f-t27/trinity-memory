    var t: u64 = 1227133513;
    if (w == 1) { t = 2454267026; }
    if (w == 2) { t = 613566756; }
    if (w == 3) { t = 1227133513; }
    if (w == 4) { t = 2454267026; }
    if (w == 5) { t = 613566756; }
    if (w == 6) { t = 1227133513; }
    if (w == 7) { t = 74898; }
    return t;
}

