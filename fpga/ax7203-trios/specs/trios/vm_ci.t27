module TriosVmCi;

// CI metadata SSOT. Run the compiled t27 program to regenerate the workflow.
// Existing third-party tools and unchanged legacy SoC utilities are invoked explicitly.
use trios::host_sys::sys_write;
const WORKFLOW: str = "# Generated by vm_ci.t27; regenerate, do not edit.\nname: fpga-ax7203-trios-vm\non:\n  workflow_dispatch:\n  push:\n    branches: ['fpga/ax7203-trios-mesh']\n    paths: ['fpga/ax7203-trios/specs/trios/vm*.t27', 'fpga/ax7203-trios/specs/trios/vsavm.t27', 'fpga/ax7203-trios/specs/trios/mutants/vsavm_mut*.t27', '.github/workflows/fpga-ax7203-trios-vm.yml']\n  pull_request:\n    paths: ['fpga/ax7203-trios/specs/trios/vm*.t27', 'fpga/ax7203-trios/specs/trios/vsavm.t27', 'fpga/ax7203-trios/specs/trios/mutants/vsavm_mut*.t27', '.github/workflows/fpga-ax7203-trios-vm.yml']\npermissions:\n  contents: read\nenv:\n  IMAGE: regymm/openxc7@sha256:35c910739e3a4b40850b85de31ebc8954985a66e982009f09123b70dbb0e75da\n  PART: xc7a200tfbg484-2\n  T27_ROOT: ${{ github.workspace }}/build/compiler\njobs:\n  firmware-sim:\n    runs-on: ubuntu-latest\n    timeout-minutes: 40\n    steps:\n      - uses: actions/checkout@v4\n      - name: Pinned compiler and Zig\n        run: |\n          git init \"$T27_ROOT\"\n          git -C \"$T27_ROOT\" remote add origin https://github.com/gHashTag/t27.git\n          git -C \"$T27_ROOT\" fetch --depth 1 origin d9737e1fd5d0571b893008a2f72d6213dac57f6e\n          git -C \"$T27_ROOT\" checkout --detach FETCH_HEAD\n          rustup toolchain install 1.94.0 --profile minimal -c llvm-tools\n          curl --fail --location https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz -o build/zig.tar.xz\n          tar -xJf build/zig.tar.xz -C build\n          echo \"$GITHUB_WORKSPACE/build/zig-x86_64-linux-0.15.2\" >> \"$GITHUB_PATH\"\n          sudo apt-get update\n          sudo apt-get install -y iverilog\n      - uses: actions/cache@v4\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            build/compiler/target\n          key: t27-vm-d9737e1f-rust194\n      - name: Build compiler\n        run: cargo +1.94.0 build --locked --release -p t27c --bin t27c --manifest-path build/compiler/Cargo.toml --target-dir build/compiler/target\n      - name: Generate firmware and execute source tests\n        run: |\n          mkdir -p build/trios\n          export T27_ROOT=\"$GITHUB_WORKSPACE/fpga/ax7203-trios\"\n          build/compiler/target/release/t27c gen fpga/ax7203-trios/specs/trios/vsavm.t27 > build/trios/vsavm.zig\n          zig test build/trios/vsavm.zig -O ReleaseSafe\n          build/compiler/target/release/t27c gen fpga/ax7203-trios/specs/trios/vm_firmware.t27 > build/trios/vm_firmware.zig\n          zig build-obj build/trios/vm_firmware.zig -target riscv32-freestanding-none -mcpu=generic_rv32 -O ReleaseSmall -fcompiler-rt -ffunction-sections -fdata-sections -femit-bin=build/trios/vm_firmware.o\n          sed -n '/^    .section .text.init/,/^3:  j 3b/p' fpga/ax7203-trios/fw/src/main.rs > build/trios/startup.s\n          zig cc -target riscv32-freestanding-none -mcpu=generic_rv32 -c build/trios/startup.s -o build/trios/startup.o\n          B=\"$(rustc +1.94.0 --print sysroot)/lib/rustlib/x86_64-unknown-linux-gnu/bin\"\n          \"$B/llvm-objcopy\" --globalize-symbol=vm_firmware.trios_main --redefine-sym=vm_firmware.trios_main=trios_main build/trios/vm_firmware.o build/trios/vm_firmware_link.o\n          \"$B/rust-lld\" -flavor gnu -m elf32lriscv -T fpga/ax7203-trios/fw/link.ld --gc-sections --no-relax build/trios/startup.o build/trios/vm_firmware_link.o -o build/trios/firmware.elf\n          \"$B/llvm-objcopy\" -O binary build/trios/firmware.elf build/trios/firmware.bin\n          python3 fpga/ax7203-trios/host/check_elf.py build/trios/firmware.elf --objdump \"$B/llvm-objdump\" --readobj \"$B/llvm-readobj\" --nm \"$B/llvm-nm\" --json build/trios/elf_checks.json\n          \"$B/llvm-objdump\" -d -M no-aliases build/trios/firmware.elf > build/trios/firmware.dis\n          ! grep -E '\\b(gp|tp)\\b' build/trios/firmware.dis\n          python3 fpga/ax7203-trios/host/make_mem.py build/trios/firmware.bin build/trios\n          build/compiler/target/release/t27c gen-verilog fpga/ax7203-trios/specs/trios/trios_uart_guard.t27 > build/trios/TriosUartGuardT27.v\n      - name: VSAVM mutants must each fail their own tests\n        run: |\n          export T27_ROOT=\"$GITHUB_WORKSPACE/fpga/ax7203-trios\"\n          mkdir -p build/trios/vsavm-mutants\n          n=0\n          for f in fpga/ax7203-trios/specs/trios/mutants/vsavm_mut*.t27; do\n            n=$((n+1)); b=$(basename \"$f\" .t27)\n            d=$(diff <(grep -v -e '^module ' -e '^// MUTANT' fpga/ax7203-trios/specs/trios/vsavm.t27) <(grep -v -e '^module ' -e '^// MUTANT' \"$f\") | grep -c '^[<>]' || true)\n            if [ \"$d\" -lt 1 ] || [ \"$d\" -gt 6 ]; then echo \"$b differs from vsavm.t27 by $d lines\"; exit 1; fi\n            build/compiler/target/release/t27c gen \"$f\" > build/trios/vsavm-mutants/$b.zig\n            if zig test build/trios/vsavm-mutants/$b.zig -O ReleaseSafe > build/trios/vsavm-mutants/$b.log 2>&1; then echo \"$b was NOT caught\"; exit 1; fi\n            grep -Eq 'test command (crashed|failed)|[0-9]+ failed' build/trios/vsavm-mutants/$b.log || { echo \"$b stopped without a test verdict\"; cat build/trios/vsavm-mutants/$b.log | head -20; exit 1; }\n            echo \"$b caught (diff $d lines)\"\n          done\n          test \"$n\" -ge 18\n      - name: Generate independent UART vectors and simulate unchanged SoC\n        run: |\n          export T27_ROOT=\"$GITHUB_WORKSPACE/fpga/ax7203-trios\"\n          build/compiler/target/release/t27c gen fpga/ax7203-trios/specs/trios/vm_vectors.t27 > build/trios/vm_vectors.zig\n          zig build-exe build/trios/vm_vectors.zig -O ReleaseSafe -lc -femit-bin=build/trios/vm_vectors\n          build/trios/vm_vectors\n          iverilog -g2012 -Ibuild/trios -o build/trios/sim.vvp -s tb_trios_soc fpga/ax7203-trios/third_party/picorv32.v build/trios/TriosUartGuardT27.v fpga/ax7203-trios/rtl/trios_soc_core.v fpga/ax7203-trios/tb/tb_trios_soc.v\n          vvp build/trios/sim.vvp | tee build/trios/sim.log\n          grep -q TB_DONE build/trios/sim.log\n          ! grep -E 'TB_TIMEOUT|TB_TRAP' build/trios/sim.log\n          cmp build/trios/expected.hex build/trios/resp.hex\n          sha256sum fpga/ax7203-trios/specs/trios/vm*.t27 fpga/ax7203-trios/specs/trios/vsavm.t27 build/trios/firmware.* build/trios/*.mem build/trios/*.hex build/zig.tar.xz > build/trios/source_artifact_sha256.txt\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: trios-vm-firmware-sim\n          path: build/trios/\n          if-no-files-found: error\n  bitstream:\n    needs: firmware-sim\n    runs-on: ubuntu-latest\n    timeout-minutes: 90\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/download-artifact@v4\n        with: {name: trios-vm-firmware-sim, path: build/trios}\n      - name: Pinned FPGA toolchain\n        run: docker pull \"$IMAGE\"\n      - uses: actions/cache/restore@v4\n        with:\n          path: build/fpga/chipdb/xc7a200tfbg484-2.bin\n          key: chipdb-xc7a200tfbg484-2-regymm-openxc7-v1\n      - name: Synthesize, route, check both clocks\n        run: |\n          test -s build/fpga/chipdb/xc7a200tfbg484-2.bin\n          D=\"docker run --rm -v $PWD:/work -w /work $IMAGE\"\n          $D yosys -q -l build/trios/yosys.log -p \"read_verilog fpga/ax7203-trios/third_party/picorv32.v; read_verilog build/trios/TriosUartGuardT27.v; read_verilog -nomem2reg -Ibuild/trios fpga/ax7203-trios/rtl/trios_soc_core.v fpga/ax7203-trios/rtl/trios_soc_ax7203.v; synth_xilinx -flatten -abc9 -nocarry -nodsp -nowidelut -nosrl -nolutram -family xc7 -top trios_soc_ax7203; setundef -zero -params; tee -o build/trios/yosys_stat.txt stat; write_json build/trios/trios_soc_ax7203.json\"\n          $D nextpnr-xilinx --chipdb build/fpga/chipdb/$PART.bin --xdc fpga/ax7203-trios/trios_soc_ax7203.xdc --json build/trios/trios_soc_ax7203.json --write build/trios/routed.json --fasm build/trios/trios_soc_ax7203.fasm --freq 25 --seed 1 --placer heap --router router2 > build/trios/nextpnr.log 2>&1\n          python3 fpga/ax7203-trios/host/check_timing.py build/trios/nextpnr.log --expect clk200=200 --expect clk25=25 --json build/trios/timing.json\n          $D git -C /nextpnr-xilinx rev-parse HEAD > build/trios/nextpnr_commit.txt\n          sha256sum build/fpga/chipdb/$PART.bin > build/trios/chipdb_sha256.txt\n      - name: Pack bitstream\n        run: |\n          docker run --rm -v \"$PWD:/work\" -w /work \"$IMAGE\" bash -c \"source /prjxray/env/bin/activate && fasm2frames --db-root /nextpnr-xilinx/xilinx/external/prjxray-db/artix7 --part $PART build/trios/trios_soc_ax7203.fasm build/trios/trios_soc_ax7203.frames && /prjxray/build/tools/xc7frames2bit --part_file /nextpnr-xilinx/xilinx/external/prjxray-db/artix7/$PART/part.yaml --part_name $PART --frm_file build/trios/trios_soc_ax7203.frames --output_file build/trios/trios_soc_ax7203.bit\"\n          sha256sum build/trios/trios_soc_ax7203.bit build/trios/firmware.elf build/trios/firmware.bin > build/trios/bitstream_sha256.txt\n          echo \"$GITHUB_SHA\" > build/trios/source_sha.txt\n          echo \"$IMAGE\" > build/trios/toolchain_image.txt\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: trios-vm-bitstream\n          path: build/trios/\n          if-no-files-found: error\n";
pub fn main() -> i32 {
    const n: i64 = sys_write(1, WORKFLOW, @as(u64, WORKFLOW.len));
    if (n == @as(i64, @intCast(WORKFLOW.len))) { return 0; }
    return 1;
}

