module ThermalPolicyT27Mut07;
// MUTANT 7: watchdog never expires. Must FAIL its own tests (CI expects a failing run).

// Thermal policy of the AX7203 TriOS board runs (owner request 2026-10-21: a cooling process,
// everything in t27). All limits are OUR TEST POLICY, not a vendor rating; none may be raised to
// make a check pass, and no command-line argument or runner option can change them (they are
// constants of this spec; the executor takes its decisions from the functions below).
//
// THREE LEVELS, kept apart on purpose:
//   1. This file: the pure policy and a pure watchdog counter, tested here (sequences of calls).
//   2. A host supervisor that reads the sensor and calls these functions: NOT written yet.
//   3. An independent hardware stop (the watchdog counter as a clocked module gating the CPU):
//      NOT built or integrated yet. Until 2 and 3 are verified end to end (sensor, actuator, loss of
//      the control channel) nothing here is "autonomous"; step() alone cannot notice that nobody calls it.
//
// Readings are milli-degrees Celsius as u32, a `valid` flag, the age of the reading in sampling periods
// and `seq`, the number of the sample (the executor numbers real sensor reads 1, 2, 3 ... mod 256; a
// re-read of a cached result carries the old number). The host converts the sensor text; a reading it
// cannot convert (command failed, no number, NaN, infinity, negative) is passed as valid = false.
//
// preflight_allows: a board may be loaded only with a fresh, valid, plausible reading strictly below
// LOAD_MAX_MC. There is no "will cool down after the load" exception.
//
// step(): OBSERVE(0) WORK(1) COOL(2) ERROR(3), state packed in one u32:
//   bits 0-1 state, 2-5 consecutive good samples, 6-13 samples spent cooling, 14-16 cooling cycles used,
//   17-24 number of the last sample.
//   - `reset` (operator) returns to OBSERVE with the counters cleared; it is the only way out of ERROR.
//   - Safety conditions act on EVERY call, whether or not the sample number is new: an implausible sample
//     (invalid, stale, out of range) -> ERROR; ERROR is sticky; dropped `want_work` -> OBSERVE; a hot sample
//     in WORK -> COOL. A sample with the number of the previous one is not new information for progress:
//     it never starts work, never counts toward leaving COOL and never advances the cooling timeout.
//   - `want_work` is the CONTINUOUS permission of the operator, read on every call: when it is false no
//     state but OBSERVE survives, and cooling never ends in WORK without it. Work is stopped by dropping
//     it, not by a pulse. OBSERVE -> WORK needs want_work and a reading below LOAD_MAX_MC.
//   - WORK -> COOL at COOL_ENTER_MC or above (work must stop, sampling goes on). The
//     (MAX_COOL_CYCLES + 1)-th entry is ERROR instead of another cycle.
//   - COOL -> WORK only after EXIT_GOOD_SAMPLES CONSECUTIVE NEW samples (numbers in sequence) at or below
//     COOL_EXIT_MC; a warm sample or a gap in the numbers restarts the count (no chatter, no reuse of one
//     cached result). COOL longer than COOL_TIMEOUT samples -> ERROR.
// Watchdog (level 3 behaviour, specified here): wd_step() counts ticks of a clock that does not depend on
// the host; a kick (a new valid sample accepted) clears it while it is running. Reaching `limit` is a TRIP and
// the trip is LATCHED: a late kick does not clear it. Only an explicit operator reset, and only while the
// policy is back in OBSERVE, re-arms it; work then needs a new sample below LOAD_MAX_MC and want_work again
// (OBSERVE -> WORK). run_enable() is the AND of the policy and an untripped watchdog: a hung host that stops
// calling step() makes the run enable fall when the watchdog trips, whatever the last state was, and
// nothing restarts it automatically.
// Sampling period of the executor: one reading per second (policy; STALE_MAX_AGE in periods).
const LOAD_MAX_MC: u32 = 70000;
const COOL_ENTER_MC: u32 = 75000;
const COOL_EXIT_MC: u32 = 65000;
const TEMP_MAX_PLAUSIBLE_MC: u32 = 200000;
const EXIT_GOOD_SAMPLES: u32 = 3;
const STALE_MAX_AGE: u32 = 3;
const COOL_TIMEOUT: u32 = 120;
const MAX_COOL_CYCLES: u32 = 3;
const WATCHDOG_LIMIT_TICKS: u32 = 5;

fn plausible(temp: u32, valid: bool, age: u32) -> bool {
    return valid && age <= STALE_MAX_AGE && temp <= TEMP_MAX_PLAUSIBLE_MC;
}

fn preflight_allows(temp: u32, valid: bool, age: u32) -> bool {
    return plausible(temp, valid, age) && temp < LOAD_MAX_MC;
}

fn pack(s: u32, good: u32, cool: u32, cyc: u32, seq: u32) -> u32 {
    return s | (good << 2) | (cool << 6) | (cyc << 14) | ((seq & 255) << 17);
}

fn state_of(p: u32) -> u32 { return p & 3; }
fn good_of(p: u32) -> u32 { return (p >> 2) & 15; }
fn cycles_of(p: u32) -> u32 { return (p >> 14) & 7; }
fn seq_of(p: u32) -> u32 { return (p >> 17) & 255; }
fn work_allowed(p: u32) -> bool { return (p & 3) == 1; }

fn step(p: u32, temp: u32, valid: bool, age: u32, seq: u32, want_work: bool, reset: bool) -> u32 {
    var s: u32 = p & 3;
    var good: u32 = (p >> 2) & 15;
    var cool: u32 = (p >> 6) & 255;
    var cyc: u32 = (p >> 14) & 7;
    var last: u32 = (p >> 17) & 255;
    var is_new: bool = seq != last;
    if (reset) { return pack(0, 0, 0, 0, seq); }
    if (!plausible(temp, valid, age)) { return pack(3, 0, 0, cyc, seq); }
    if (s == 3) { return pack(3, 0, 0, cyc, seq); }
    if (!want_work) { return pack(0, 0, 0, cyc, seq); }
    if (s == 0) {
        if (is_new && temp < LOAD_MAX_MC) { return pack(1, 0, 0, cyc, seq); }
        return pack(0, 0, 0, cyc, seq);
    }
    if (s == 1) {
        if (temp >= COOL_ENTER_MC) {
            if (cyc >= MAX_COOL_CYCLES) { return pack(3, 0, 0, cyc, seq); }
            return pack(2, 0, 0, cyc + 1, seq);
        }
        return pack(1, 0, 0, cyc, seq);
    }
    if (!is_new) { return p; }
    if (cool + 1 >= COOL_TIMEOUT) { return pack(3, 0, 0, cyc, seq); }
    if (temp <= COOL_EXIT_MC && seq == ((last + 1) & 255)) {
        if (good + 1 >= EXIT_GOOD_SAMPLES) { return pack(1, 0, 0, cyc, seq); }
        return pack(2, good + 1, cool + 1, cyc, seq);
    }
    return pack(2, 0, cool + 1, cyc, seq);
}

/// One tick of the watchdog. A running counter is cleared by a kick; at `limit` it has tripped and stays
/// tripped (a kick is ignored) until `reset` is given while the policy is in OBSERVE.
fn wd_step(count: u32, p: u32, kick: bool, reset: bool, limit: u32) -> u32 {
    if (count >= limit) {
        if (reset && (p & 3) == 0) { return 0; }
        return count;
    }
    if (kick) { return 0; }
    return count + 1;
}

fn wd_expired(count: u32, limit: u32) -> bool { return false; }

fn run_enable(p: u32, count: u32, limit: u32) -> bool {
    return work_allowed(p) && !wd_expired(count, limit);
}

fn hot_run(p0: u32, first_seq: u32) -> u32 {
    var p: u32 = p0;
    var i: u32 = 0;
    while (i < 119) {
        p = step(p, 80000, true, 0, first_seq + i, true, false);
        i = i + 1;
    }
    return p;
}

fn silent_ticks(c0: u32) -> u32 {
    var c: u32 = c0;
    var i: u32 = 0;
    while (i < 4) {
        c = wd_step(c, 0, false, false, WATCHDOG_LIMIT_TICKS);
        i = i + 1;
    }
    return c;
}

test preflight_limit_is_strict {
    assert_eq(preflight_allows(69999, true, 0), true);
    assert_eq(preflight_allows(70000, true, 0), false);
    assert_eq(preflight_allows(93959, true, 0), false);
}
test preflight_refuses_bad_readings {
    assert_eq(preflight_allows(50000, false, 0), false);
    assert_eq(preflight_allows(50000, true, 4), false);
    assert_eq(preflight_allows(200001, true, 0), false);
    assert_eq(preflight_allows(50000, true, 3), true);
}
test observe_waits_for_the_operator_and_a_cool_die {
    var p: u32 = 0;
    p = step(p, 50000, true, 0, 1, false, false);
    assert_eq(state_of(p), 0);
    p = step(p, 70000, true, 0, 2, true, false);
    assert_eq(state_of(p), 0);
    p = step(p, 69999, true, 0, 3, true, false);
    assert_eq(state_of(p), 1);
    assert_eq(work_allowed(p), true);
}
test dropping_want_work_stops_work_at_once {
    var p: u32 = pack(1, 0, 0, 0, 5);
    p = step(p, 50000, true, 0, 6, true, false);
    assert_eq(work_allowed(p), true);
    p = step(p, 50000, true, 0, 7, false, false);
    assert_eq(state_of(p), 0);
    assert_eq(work_allowed(p), false);
    p = step(p, 50000, true, 0, 8, false, false);
    assert_eq(work_allowed(p), false);
    p = step(p, 50000, true, 0, 9, true, false);
    assert_eq(work_allowed(p), true);
}
test cooling_enters_at_the_threshold_and_stops_work {
    var p: u32 = pack(1, 0, 0, 0, 5);
    p = step(p, 74999, true, 0, 6, true, false);
    assert_eq(state_of(p), 1);
    p = step(p, 75000, true, 0, 7, true, false);
    assert_eq(state_of(p), 2);
    assert_eq(work_allowed(p), false);
    assert_eq(cycles_of(p), 1);
}
test cooling_leaves_only_after_three_new_good_samples_without_chatter {
    var p: u32 = pack(2, 0, 0, 1, 10);
    p = step(p, 66000, true, 0, 11, true, false);
    p = step(p, 65000, true, 0, 12, true, false);
    p = step(p, 65000, true, 0, 13, true, false);
    assert_eq(state_of(p), 2);
    p = step(p, 66000, true, 0, 14, true, false);
    p = step(p, 65000, true, 0, 15, true, false);
    p = step(p, 65000, true, 0, 16, true, false);
    assert_eq(state_of(p), 2);
    p = step(p, 65000, true, 0, 17, true, false);
    assert_eq(state_of(p), 1);
    assert_eq(work_allowed(p), true);
}
test cooling_never_ends_in_work_without_the_operators_permission {
    var p: u32 = pack(2, 0, 0, 1, 20);
    p = step(p, 60000, true, 0, 21, true, false);
    p = step(p, 60000, true, 0, 22, false, false);
    assert_eq(state_of(p), 0);
    p = step(p, 60000, true, 0, 23, false, false);
    p = step(p, 60000, true, 0, 24, false, false);
    p = step(p, 60000, true, 0, 25, false, false);
    assert_eq(work_allowed(p), false);
}
test one_cached_result_read_again_counts_once {
    var p: u32 = pack(2, 0, 0, 1, 30);
    p = step(p, 60000, true, 0, 31, true, false);
    p = step(p, 60000, true, 0, 31, true, false);
    p = step(p, 60000, true, 0, 31, true, false);
    p = step(p, 60000, true, 0, 31, true, false);
    assert_eq(state_of(p), 2);
    assert_eq(good_of(p), 1);
}
test a_gap_in_the_sample_numbers_restarts_the_count {
    var p: u32 = pack(2, 0, 0, 1, 40);
    p = step(p, 60000, true, 0, 41, true, false);
    p = step(p, 60000, true, 0, 42, true, false);
    assert_eq(good_of(p), 2);
    p = step(p, 60000, true, 0, 44, true, false);
    assert_eq(state_of(p), 2);
    assert_eq(good_of(p), 0);
}
test sensor_loss_is_an_error_and_never_resumes_by_itself {
    var p: u32 = pack(1, 0, 0, 0, 50);
    p = step(p, 50000, false, 0, 51, true, false);
    assert_eq(state_of(p), 3);
    p = step(p, 40000, true, 0, 52, true, false);
    p = step(p, 40000, true, 0, 53, true, false);
    p = step(p, 40000, true, 0, 54, true, false);
    p = step(p, 40000, true, 0, 55, true, false);
    assert_eq(state_of(p), 3);
    assert_eq(work_allowed(p), false);
    p = step(p, 40000, true, 0, 56, true, true);
    assert_eq(state_of(p), 0);
}
test stale_and_implausible_readings_are_errors_in_every_state {
    assert_eq(state_of(step(pack(0, 0, 0, 0, 1), 50000, true, 4, 2, true, false)), 3);
    assert_eq(state_of(step(pack(1, 0, 0, 0, 1), 200001, true, 0, 2, true, false)), 3);
    assert_eq(state_of(step(pack(2, 0, 0, 1, 1), 50000, true, 4, 2, true, false)), 3);
}
test cooling_timeout_is_an_error {
    var p: u32 = pack(2, 0, 0, 1, 100);
    p = hot_run(p, 101);
    assert_eq(state_of(p), 2);
    p = step(p, 80000, true, 0, 220, true, false);
    assert_eq(state_of(p), 3);
}
test the_cycle_limit_ends_in_an_error {
    var p: u32 = pack(1, 0, 0, 0, 1);
    p = step(p, 80000, true, 0, 2, true, false);
    assert_eq(cycles_of(p), 1);
    p = step(p, 60000, true, 0, 3, true, false);
    p = step(p, 60000, true, 0, 4, true, false);
    p = step(p, 60000, true, 0, 5, true, false);
    assert_eq(state_of(p), 1);
    p = step(p, 80000, true, 0, 6, true, false);
    p = step(p, 60000, true, 0, 7, true, false);
    p = step(p, 60000, true, 0, 8, true, false);
    p = step(p, 60000, true, 0, 9, true, false);
    p = step(p, 80000, true, 0, 10, true, false);
    assert_eq(cycles_of(p), 3);
    p = step(p, 60000, true, 0, 11, true, false);
    p = step(p, 60000, true, 0, 12, true, false);
    p = step(p, 60000, true, 0, 13, true, false);
    assert_eq(state_of(p), 1);
    p = step(p, 80000, true, 0, 14, true, false);
    assert_eq(state_of(p), 3);
}
test the_watchdog_cuts_the_run_enable_when_nobody_calls_step {
    var p: u32 = pack(1, 0, 0, 0, 9);
    var c: u32 = 0;
    assert_eq(run_enable(p, c, WATCHDOG_LIMIT_TICKS), true);
    c = silent_ticks(c);
    assert_eq(run_enable(p, c, WATCHDOG_LIMIT_TICKS), true);
    c = wd_step(c, p, false, false, WATCHDOG_LIMIT_TICKS);
    assert_eq(wd_expired(c, WATCHDOG_LIMIT_TICKS), true);
    assert_eq(work_allowed(p), true);
    assert_eq(run_enable(p, c, WATCHDOG_LIMIT_TICKS), false);
}
test a_kick_restarts_a_running_watchdog_only {
    var c: u32 = silent_ticks(0);
    c = wd_step(c, 0, true, false, WATCHDOG_LIMIT_TICKS);
    assert_eq(c, 0);
    assert_eq(wd_expired(c, WATCHDOG_LIMIT_TICKS), false);
}
test a_late_kick_does_not_clear_a_trip_and_work_stays_forbidden {
    var p: u32 = pack(1, 0, 0, 0, 9);
    var c: u32 = silent_ticks(0);
    c = wd_step(c, p, false, false, WATCHDOG_LIMIT_TICKS);
    assert_eq(wd_expired(c, WATCHDOG_LIMIT_TICKS), true);
    c = wd_step(c, p, true, false, WATCHDOG_LIMIT_TICKS);
    assert_eq(wd_expired(c, WATCHDOG_LIMIT_TICKS), true);
    p = step(p, 50000, true, 0, 10, true, false);
    c = wd_step(c, p, true, false, WATCHDOG_LIMIT_TICKS);
    assert_eq(work_allowed(p), true);
    assert_eq(run_enable(p, c, WATCHDOG_LIMIT_TICKS), false);
}
test a_trip_is_rearmed_only_by_an_operator_reset_with_the_policy_back_in_observe {
    var p: u32 = pack(1, 0, 0, 0, 9);
    var c: u32 = 5;
    c = wd_step(c, p, false, true, WATCHDOG_LIMIT_TICKS);
    assert_eq(wd_expired(c, WATCHDOG_LIMIT_TICKS), true);
    p = step(p, 50000, true, 0, 10, true, true);
    assert_eq(state_of(p), 0);
    c = wd_step(c, p, false, false, WATCHDOG_LIMIT_TICKS);
    assert_eq(wd_expired(c, WATCHDOG_LIMIT_TICKS), true);
    c = wd_step(c, p, false, true, WATCHDOG_LIMIT_TICKS);
    assert_eq(c, 0);
    assert_eq(run_enable(p, c, WATCHDOG_LIMIT_TICKS), false);
    p = step(p, 50000, true, 0, 11, true, false);
    assert_eq(run_enable(p, c, WATCHDOG_LIMIT_TICKS), true);
}
test a_repeated_sample_number_still_honours_stop {
    var p: u32 = pack(1, 0, 0, 0, 5);
    p = step(p, 50000, true, 0, 5, false, false);
    assert_eq(state_of(p), 0);
    assert_eq(work_allowed(p), false);
}
test a_repeated_sample_number_still_raises_stale_and_invalid {
    assert_eq(state_of(step(pack(1, 0, 0, 0, 5), 50000, true, 4, 5, true, false)), 3);
    assert_eq(state_of(step(pack(1, 0, 0, 0, 5), 50000, false, 0, 5, true, false)), 3);
    assert_eq(state_of(step(pack(2, 0, 0, 1, 5), 50000, true, 4, 5, true, false)), 3);
    assert_eq(state_of(step(pack(0, 0, 0, 0, 5), 50000, false, 0, 5, true, false)), 3);
}
test a_repeated_sample_number_still_reacts_to_heat_but_never_starts_work_or_counts {
    assert_eq(state_of(step(pack(1, 0, 0, 0, 5), 80000, true, 0, 5, true, false)), 2);
    assert_eq(state_of(step(pack(0, 0, 0, 0, 5), 50000, true, 0, 5, true, false)), 0);
    var p: u32 = pack(2, 1, 4, 1, 5);
    p = step(p, 50000, true, 0, 5, true, false);
    assert_eq(good_of(p), 1);
    assert_eq(state_of(p), 2);
}
test plausibility_edges {
    assert_eq(plausible(200000, true, 0), true);
    assert_eq(plausible(200001, true, 0), false);
    assert_eq(plausible(0, true, 3), true);
    assert_eq(plausible(0, true, 4), false);
    assert_eq(plausible(0, false, 0), false);
}
test sample_numbers_wrap_at_256_and_still_count_as_consecutive {
    var p: u32 = pack(2, 0, 0, 1, 253);
    p = step(p, 60000, true, 0, 254, true, false);
    p = step(p, 60000, true, 0, 255, true, false);
    assert_eq(good_of(p), 2);
    assert_eq(seq_of(p), 255);
    p = step(p, 60000, true, 0, 0, true, false);
    assert_eq(state_of(p), 1);
    assert_eq(seq_of(p), 0);
}
