## AX7203 DDR3 build, x32 only (DDR3_WIDTH=32): byte lanes 2 and 3, the upper
## chip U5 (DQ[31:16]). Appended to tms_ddr3_ax7203.xdc by the Makefile.
# byte lane 2 (chip U5), bank 35, byte group T2
set_property PACKAGE_PIN L4 [get_ports ddr3_dq[16]]
set_property IOSTANDARD SSTL15 [get_ports ddr3_dq[16]]
set_property SLEW FAST [get_ports ddr3_dq[16]]
